{
  "name": "js-modules",
  "private": true,
  "scripts": {
    "clean:build": "pnpm clean:build-javascript && pnpm clean:build-python && pnpm clean:build-react-native",
    "clean:build-javascript": "pnpm dlx rimraf --glob **/build **/dist **/coverage **/build_keycloak **/*.tsbuildinfo",
    "clean:build-python": "pnpm dlx rimraf --glob **/__pycache__ **/.pytest_cache **/*.egg-info **/.ruff_cache",
    "clean:build-react-native": "pnpm dlx rimraf --glob **/.gradle **/.kotlin **/.cxx",
    "clean:graph": "pnpm dlx rimraf --glob **/dependency-graph*",
    "clean:lock-files": "pnpm clean:lock-files-javascript && pnpm clean:lock-files-python",
    "clean:lock-files-javascript": "pnpm dlx rimraf --glob **/package-lock.json **/pnpm-lock.yaml **/yarn.lock",
    "clean:lock-files-python": "pnpm dlx rimraf --glob **/uv.lock",
    "clean:main": "pnpm clean:main-javascript && pnpm clean:main-python && pnpm clean:main-react-native && pnpm clean:main-nx && pnpm clean:main-docker",
    "clean:main-docker": "pnpm dlx rimraf .dockerignore",
    "clean:main-javascript": "pnpm dlx rimraf --glob **/node_modules .prettierignore .solhintignore",
    "clean:main-nx": "pnpm dlx rimraf --glob **/.nx .nxignore",
    "clean:main-python": "pnpm dlx rimraf .venv",
    "clean:main-react-native": "pnpm dlx rimraf --glob **/Pods vendor/bundle",
    "git-hooks:clean": "tsx scripts/pkg-root/git-hooks.clean.ts",
    "git-hooks:reset": "pnpm git-hooks:clean && pnpm git-hooks:set",
    "git-hooks:set": "tsx scripts/pkg-root/git-hooks.set.ts",
    "graph:dependency-map": "monorepo-mapper --format pdf",
    "graph:nx": "pnpm nx graph",
    "graph:package-tree": "tsx scripts/pkg-root/graph.package-tree.ts",
    "install:all": "pnpm install:javascript && pnpm install:python",
    "install:javascript": "pnpm install",
    "install:python": "tsx scripts/toml/toml.download-schemas.ts && uv sync --all-packages",
    "lint:check": "pnpm nx run-many -t lint:check",
    "lint:fix": "pnpm nx run-many -t lint:fix",
    "lint:health": "pnpm nx run-many -t lint:health",
    "lint:staged-check": "tsx scripts/nx/nx.lint-staged.ts --mode check",
    "lint:staged-fix": "tsx scripts/nx/nx.lint-staged.ts --mode fix",
    "reset": "pnpm reset:clean && pnpm reset:install",
    "reset:clean": "pnpm clean:main && pnpm clean:build",
    "reset:install": "pnpm install:all && tsx scripts/pkg-root/reset.ignore-symlinks.ts && tsx scripts/pkg-root/reset.package-references.ts && pnpm nx run root:lint:fix",
    "test": "pnpm nx run-many -t test",
    "test:coverage": "pnpm nx run-many -t test:coverage",
    "test:health": "pnpm nx run-many -t test:health",
    "test:watch": "pnpm nx run-many -t test:watch",
    "types:check": "pnpm nx run-many -t types:check"
  },
  "lint-staged": {
    "*": "tsx scripts/nx/nx.lint-staged.ts"
  },
  "prettier": {
    "plugins": [
      "@prettier/plugin-xml",
      "prettier-plugin-packagejson",
      "prettier-plugin-sh",
      "prettier-plugin-solidity",
      "prettier-plugin-sql",
      "prettier-plugin-svelte",
      "prettier-plugin-tailwindcss"
    ],
    "trailingComma": "all",
    "xmlWhitespaceSensitivity": "ignore",
    "overrides": [
      {
        "files": "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,svelte,vue,md,markdown,mdx,yml,yaml,sql}",
        "options": {
          "singleQuote": true
        }
      }
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-angular": "^20.5.3",
    "@html-eslint/eslint-plugin": "^0.60.0",
    "@jest/globals": "^30.3.0",
    "@nx/devkit": "^22.7.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@react-native/jest-preset": "^0.85.3",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@taplo/cli": "^0.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chai": "^5.2.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "esbuild-register": "^3.6.0",
    "eslint": "10.3.0",
    "eslint-config-flat-gitignore": "^2.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-chai-friendly": "^1.2.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mocha": "^11.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-svelte": "^3.17.1",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "mocha": "^11.7.5",
    "monorepo-mapper": "^1.0.5",
    "nx": "^22.7.1",
    "prettier": "3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.18.1",
    "prettier-plugin-solidity": "^2.3.1",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shellcheck": "^4.1.0",
    "solhint": "^6.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
