{
  "name": "js-modules",
  "private": true,
  "scripts": {
    "clean:main-docker": "pnpm dlx rimraf .dockerignore",
    "clean:main-js": "pnpm dlx rimraf --glob **/node_modules .husky .eslintignore .prettierignore .solhintignore",
    "clean:main-nx": "pnpm dlx rimraf --glob **/.nx .nxignore",
    "clean:main-py": "pnpm dlx rimraf .venv",
    "clean:main-react-native": "pnpm dlx rimraf --glob **/Pods vendor/bundle",
    "clean:main": "pnpm clean:main-js & pnpm clean:main-py & pnpm clean:main-react-native & pnpm clean:main-nx & pnpm clean:main-docker & wait",
    "clean:build-js": "pnpm dlx rimraf --glob **/build **/dist **/coverage **/build_keycloak **/*.tsbuildinfo",
    "clean:build-py": "pnpm dlx rimraf --glob **/__pycache__ **/.pytest_cache **/*.egg-info **/.ruff_cache",
    "clean:build-react-native": "pnpm dlx rimraf --glob **/.gradle **/.kotlin **/.cxx",
    "clean:build": "pnpm clean:build-js & pnpm clean:build-py & pnpm clean:build-react-native & wait",
    "clean:graph": "pnpm dlx rimraf --glob **/dependency-graph*",
    "clean:lock-files-js": "pnpm dlx rimraf --glob **/package-lock.json **/pnpm-lock.yaml **/yarn.lock",
    "clean:lock-files-py": "pnpm dlx rimraf --glob **/uv.lock",
    "clean:lock-files": "pnpm clean:lock-files-js & pnpm clean:lock-files-py & wait",
    "clean:git-hooks": "git config --unset core.hooksPath",
    "install:js": "pnpm install",
    "install:py": "uv sync",
    "reset:clean": "pnpm clean:main && pnpm clean:build",
    "reset:install": "ln -s .gitignore .eslintignore && ln -s .gitignore .prettierignore && ln -s .gitignore .nxignore && ln -s .gitignore .dockerignore && ln -s .gitignore .solhintignore && (pnpm install:js & pnpm install:py & wait)",
    "reset:reset": "pnpm reset:clean && pnpm reset:install",
    "git-hooks:set": "husky install && pnpm husky add .husky/pre-commit 'pnpm lint:fix' && pnpm husky add .husky/pre-commit 'pnpm commitlint --edit $1'",
    "git-hooks:reset": "pnpm clean:git-hooks && pnpm git-hooks:set",
    "graph:dependency-map": "monorepo-mapper --format pdf",
    "graph:nx": "pnpm nx graph",
    "graph:package-tree": " tree -d -L 3 packages",
    "lint:check": "(eslint       './**/*.{js,jsx,ts,tsx}' && prettier --list-different './**/*.{js,jsx,ts,tsx,css,scss,less,json,md,yml,yaml}') & (prettier --config ./prettier-config-solidity.js --list-different './**/*.sol' && solhint       './**/*.sol') & (uv run ruff check .       && uv run ruff format --check .) & wait",
    "lint:fix": "  (eslint --fix './**/*.{js,jsx,ts,tsx}' && prettier --write          './**/*.{js,jsx,ts,tsx,css,scss,less,json,md,yml,yaml}') & (prettier --config ./prettier-config-solidity.js --write          './**/*.sol' && solhint --fix './**/*.sol') & (uv run ruff check --fix . && uv run ruff format .        ) & wait"
  },
  "dependencies": {
    "@types/node": "^25.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-angular": "^20.5.0",
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "eslint": "10.0.3",
    "eslint-config-airbnb-typescript-prettier": "^5.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-jsdoc": "^62.8.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "monorepo-mapper": "^1.0.5",
    "nx": "^22.5.4",
    "prettier": "3.8.1",
    "prettier-plugin-solidity": "^2.3.1",
    "solhint": "^6.0.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.6.0",
    "@typescript-eslint/parser": "^5.6.0",
    "eslint-config-airbnb": "^19.0.2",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-react": "^7.27.1",
    "eslint-plugin-react-hooks": "^4.3.0"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "plugin:jest/recommended",
      "plugin:jest/style",
      "airbnb-typescript-prettier"
    ],
    "settings": {
      "import/resolver": {
        "typescript": {}
      }
    },
    "env": {
      "jest/globals": true
    },
    "rules": {
      "no-underscore-dangle": "off",
      "import/prefer-default-export": "off",
      "react/require-default-props": "off",
      "react/function-component-definition": "off",
      "@typescript-eslint/no-non-null-assertion": "off"
    }
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@types/react-window": "1.8.8",
      "eslint": "8.57.0",
      "prettier": "2.8.8",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-window": "1.8.11",
      "vite-tsconfig-paths": "4.3.2"
    }
  }
}
