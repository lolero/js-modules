{
  "private": true,
  "name": "@js-modules/apps-travel-log-native",
  "description": "Apps Travel Log Native",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:travel-log-native": "react-native start",
    "dev:travel-log-native-clean": "pnpm dev:travel-log-native --reset-cache",
    "metro:exit-server": "pkill -9 -f \"cli.js start\"",
    "android:emulator-list": "~/Android/Sdk/emulator/emulator -list-avds",
    "android:emulator-start": "~/Android/Sdk/emulator/emulator -avd Medium_Phone",
    "android:emulator-start-clean": "~/Android/Sdk/emulator/emulator -avd Medium_Phone -wipe-data -no-snapshot",
    "android:emulator-exit": "adb emu kill",
    "android:emulator-certificate-push": "adb push ../apps-travel-log-config-docker/docker-compose/travel-log-dev/ssl/nginx-selfsigned.crt /sdcard/Download/nginx-selfsigned.crt",
    "android:emulator-certificate-delete": "adb shell \"rm -f /sdcard/Download/nginx-selfsigned.crt\"",
    "android:emulator-app-clean": "cd android && ./gradlew clean",
    "android:emulator-app-install": "cd android && ./gradlew installDebug",
    "android:emulator-app-run": "adb shell am start -n com.travellognative/.MainActivity",
    "android:emulator-app-exit": "adb shell am force-stop com.travellognative",
    "android:emulator-app-uninstall": "adb uninstall com.travellognative",
    "android:emulator-app-restart": "pnpm android:emulator-app-exit && pnpm android:emulator-app-install && pnpm android:emulator-app-run",
    "android:emulator-app-restart-clean": "pnpm android:emulator-app-exit && pnpm android:emulator-app-clean && pnpm android:emulator-app-install && pnpm android:emulator-app-run",
    "android:emulator-app-reinstall": "pnpm android:emulator-app-exit && pnpm android:emulator-app-uninstall && pnpm android:emulator-app-clean && pnpm android:emulator-app-install && pnpm android:emulator-app-run",
    "android:reset": "pnpm android:app-uninstall && pnpm android:emulator-exit && pnpm android:clean && pnpm android:emulator-run-app",
    "android:reverse-port-fwd": "adb reverse tcp:8081 tcp:8081",
    "ios:emulator-run-app": "react-native run-ios"
  },
  "dependencies": {
    "@js-modules/apps-travel-log-common-constants": "workspace:^",
    "@js-modules/apps-travel-log-common-react": "workspace:^",
    "@js-modules/apps-travel-log-common-store-redux": "workspace:^",
    "@js-modules/apps-travel-log-native-my-feeds": "workspace:^",
    "@js-modules/apps-travel-log-native-start": "workspace:^",
    "@react-native-vector-icons/fontawesome": "^12.4.0",
    "@react-navigation/native": "^7.1.21",
    "@react-navigation/native-stack": "^7.8.0",
    "@types/react": "^19.1.1",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-app-auth": "^8.1.0",
    "react-native-keychain": "^10.0.0",
    "react-native-paper": "^5.14.5",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.18.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/codegen": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/gradle-plugin": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "19.1.1"
  }
}
