FROM node:lts-alpine3.22 as image-build
WORKDIR '/app'
RUN npm install -g pnpm
COPY . .
RUN pnpm reset:reset
RUN pnpm nx run @js-modules/apps-travel-log-web:build

FROM nginx:1.29.1-alpine
EXPOSE 8080

# Build argument for user UID
ARG USER_UID

# Copy files
COPY --from=image-build /app/packages/apps/travel-log/apps-travel-log-config-docker/service-images/client-web/nginx.conf.client-web.prod /etc/nginx/conf.d/default.conf
COPY --from=image-build /app/packages/apps/travel-log/apps-travel-log-web/build /usr/share/nginx/html

# Set permissions for uid specified in docker-compose
RUN chown -R ${USER_UID}:${USER_UID} /usr/share/nginx/html && \
    chown -R ${USER_UID}:${USER_UID} /var/cache/nginx && \
    chown -R ${USER_UID}:${USER_UID} /var/log/nginx && \
    chown -R ${USER_UID}:${USER_UID} /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R ${USER_UID}:${USER_UID} /var/run/nginx.pid && \
    chmod 1777 /tmp
