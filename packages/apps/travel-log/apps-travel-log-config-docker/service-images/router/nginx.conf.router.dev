upstream client-web {
  server host.docker.internal:5173;
}

upstream auth-service {
  server auth-service:8080;
}

upstream api-core {
  server host.docker.internal:3000;
}

# HTTP server - redirect to HTTPS
server {
  listen 80;
  # Only accept requests from localhost and Android emulator (10.0.2.2)
  server_name localhost 10.0.2.2;
  return 301 https://$host$request_uri;
}

# HTTPS server
server {
  listen 443 ssl;
  # Only accept requests from localhost and Android emulator (10.0.2.2)
  server_name localhost 10.0.2.2;

  # SSL configuration
  ssl_certificate /etc/nginx/ssl/nginx-selfsigned.crt;
  ssl_certificate_key /etc/nginx/ssl/nginx-selfsigned.key;
  ssl_dhparam /etc/nginx/ssl/dhparam.pem;

  # SSL settings
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers HIGH:!aNULL:!MD5;
  ssl_prefer_server_ciphers on;

  # Security headers
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-XSS-Protection "1; mode=block" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  location / {
    proxy_pass http://client-web;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }

  location /auth/ {
    proxy_pass http://auth-service/auth/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host; # Necessary for react-native Android redirects to work
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Port 443;
  }

  location /api {
    rewrite /api/(.*) /$1 break;
    proxy_pass http://api-core;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}