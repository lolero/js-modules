FROM node:lts-alpine3.22 as image-build
WORKDIR '/app'
RUN apk add --no-cache maven curl bash
RUN npm install -g pnpm
COPY . .
RUN pnpm reset:reset
RUN pnpm nx run @js-modules/apps-travel-log-web-keycloak-theme:keycloakify:build
RUN cd packages/apps/travel-log/apps-travel-log-config-docker/service-images/auth-service && ./download-providers.sh

FROM quay.io/keycloak/keycloak:26.3.5-0

# Build argument for user UID
ARG USER_UID
ARG DOMAIN_PROD

# Copy files
COPY --from=image-build /app/packages/apps/travel-log/apps-travel-log-config-docker/service-images/auth-service/backup/realm-backup.prod.json /opt/keycloak/data/import/realm-backup.json
COPY --from=image-build /app/packages/apps/travel-log/apps-travel-log-config-docker/service-images/auth-service/providers /opt/keycloak/providers

# Substitute $DOMAIN_PROD in keycloak's realm backup
USER root
RUN sed -i "s/\$DOMAIN_PROD/${DOMAIN_PROD}/g" /opt/keycloak/data/import/realm-backup.json

# Build Keycloak
RUN /opt/keycloak/bin/kc.sh build --db=postgres --http-relative-path=/auth

# Set permissions for uid specified in docker-compose
RUN chown -R ${USER_UID}:${USER_UID} /opt/keycloak && \
    chmod -R g+w /opt/keycloak
