{
  "private": true,
  "name": "@js-modules/apps-travel-log-api-core",
  "description": "Apps Travel Log Api Core",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:travel-log-api-core": "cross-env NODE_ENV=development NODE_TLS_REJECT_UNAUTHORIZED=0 nest start --watch",
    "build": "nest build -p tsconfig.build.json",
    "prod": "cross-env NODE_ENV=production NODE_TLS_REJECT_UNAUTHORIZED=0 node build/main",
    "typeorm": "nx build && cross-env NODE_ENV=development typeorm -d build/config/config.typeorm.dataSource.js",
    "test:test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@js-modules/api-nest-module-auth-keycloak": "workspace:^",
    "@js-modules/api-nest-utils": "workspace:^",
    "@js-modules/apps-travel-log-api-modules-core": "workspace:^",
    "@js-modules/apps-travel-log-common-constants-cjs": "workspace:^",
    "@js-modules/common-utils-general-cjs": "workspace:^",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/testing": "^11.1.11",
    "@nestjs/typeorm": "^11.0.0",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.21",
    "@types/supertest": "^6.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-session": "^2.1.1",
    "express": "^5.2.1",
    "keycloak-connect": "^26.1.1",
    "keycloak-js": "26.2.2",
    "lodash": "^4.17.21",
    "nest-keycloak-connect": "^1.10.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.4"
  },
  "eslintConfig": {
    "rules": {
      "class-methods-use-this": "off",
      "no-useless-constructor": "off",
      "no-param-reassign": "off"
    }
  }
}
