{
  "private": true,
  "name": "@js-modules/api-nest-module-auth-keycloak",
  "description": "Api Nest Module Auth Keycloak",
  "version": "0.0.0",
  "license": "MIT",
  "main": "build/index",
  "files": [
    "build"
  ],
  "scripts": {
    "fix-keycloak-types": "ts-node --project tsconfig.fix-keycloak-types.json -r tsconfig-paths/register src/utils/fixKeycloakTypes.ts",
    "build": "pnpm fix-keycloak-types && tsc -b tsconfig.build.json",
    "test:test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@js-modules/api-nest-keycloak-admin-client-cjs": "workspace:^",
    "@js-modules/api-nest-utils": "workspace:^",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/testing": "^11.1.17",
    "@nestjs/typeorm": "^11.0.0",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/supertest": "^7.2.0",
    "axios": "^1.13.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "keycloak-connect": "^26.1.1",
    "keycloak-js": "26.2.3",
    "lodash": "^4.17.23",
    "nest-keycloak-connect": "^1.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "eslintConfig": {
    "rules": {
      "class-methods-use-this": "off",
      "no-useless-constructor": "off",
      "no-param-reassign": "off"
    }
  }
}
